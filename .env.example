# Copy to .env and fill in, then: docker compose up -d --build

# Rails secret. Generate one with:  openssl rand -hex 64
SECRET_KEY_BASE=

# Postgres password for the app database.
DB_PASSWORD=change-me

# Host port the public site is served on (proxy TLS in front of this).
WEB_PORT=8080

# The first admin account, created on first boot. Sign in at /admin with
# ADMIN_EMAIL and this password, then add everyone else under Staff. Use a
# strong password (10+ characters). The same pair signs in to Avo at /avo.
ADMIN_EMAIL=admin@harnesslink.com
ADMIN_PASSWORD=change-me-too

# STAGING ONLY: send "X-Robots-Tag: noindex" on every page so Google never
# indexes the staging copy. Leave this EMPTY in production.
NOINDEX=true

# Public address of the Strapi admin + media, including the sub-folder nginx
# serves it under. Also compiled into the admin panel at build time.
CMS_PUBLIC_URL=https://staging.harnesslink.com/cms

# Responsive images (optional). Leave IMGPROXY_URL empty to serve originals.
# To enable WebP/AVIF resizing, set it to the PUBLIC imgproxy address
# (e.g. https://img.harnesslink.com, or http://<host>:8081 for a quick test).
IMGPROXY_URL=
IMGPROXY_PORT=8081
# Optional signing (hex). Blank = insecure signatures (fine behind a private proxy).
IMGPROXY_KEY=
IMGPROXY_SALT=

# Publish → social webhook (Zapier / Make / Ayrshare). Leave empty to disable.
SOCIAL_WEBHOOK_URL=

# Site search (Meilisearch). A long random string (openssl rand -hex 32);
# leave empty to fall back to plain database search.
MEILI_MASTER_KEY=
# Search-only key for the website: after first start, run
#   curl -s -H "Authorization: Bearer $MEILI_MASTER_KEY" http://<search>:7700/keys
# and copy the "Default Search API Key".
MEILI_SEARCH_KEY=

# Preview button (Strapi -> site): the public site address and a long random
# secret (openssl rand -hex 24), shared by the cms and web containers.
SITE_URL=
PREVIEW_SECRET=

# HarnessLink racing API (Next To Go / Results widget on the home page).
# A read-only service key (hls_...) with racing:read; leave empty to hide the widget.
HARNESSLINK_API_URL=https://admin.harnesslink.com/api
HARNESSLINK_API_KEY=

# Matomo analytics (cookieless). e.g. https://analytics.harnesslink.com and the site id from Matomo.
MATOMO_URL=
MATOMO_SITE_ID=

# CMS home-screen dashboard keys (read-only). MATOMO_TOKEN: Matomo personal token for a view-only user.
# POSTIZ_API_KEY: Postiz Settings > Public API. Racing uses HARNESSLINK_API_KEY above.
MATOMO_TOKEN=
POSTIZ_URL=https://social.harnesslink.com
POSTIZ_API_KEY=

# Reader sign-in emails through Brevo (Settings > SMTP & API > SMTP).
# Leave SMTP_HOST empty and emails are only logged, never sent.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Harnesslink <no-reply@harnesslink.com>

# The Insider's Mailchimp audience: API key (ends -usNN) and audience id.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
