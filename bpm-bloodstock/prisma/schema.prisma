// BPM Bloodstock - micro-shares syndication data model.
// Money is stored as integer cents (AUD). SQLite for the scaffold; switch the
// provider to postgresql for production (no model changes required).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  isAdmin      Boolean  @default(false)

  // Wallet balance in integer cents. Every mutation is mirrored by a
  // WalletTransaction row so the balance is always reconstructable/auditable.
  walletBalanceCents Int @default(0)

  holdings     ShareHolding[]
  orders       Order[]
  transactions WalletTransaction[]
  payouts      PrizeDistribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Offering {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String // horse name
  discipline  String // "Pacer" | "Trotter" | "Galloper"
  tagline     String   @default("")
  description String   @default("")
  heroColor   String   @default("gold") // "gold" | "green" for the silks tile
  trainer     String   @default("")
  sire        String   @default("")
  dam         String   @default("")
  // Optional horse photo / poster (path under /public or an https URL).
  // Falls back to a branded graphic when empty.
  imageUrl    String   @default("")

  totalShares     Int // total micro-shares issued for this horse
  sharePriceCents Int // price per single share
  sharesSold      Int      @default(0)
  // Management fee retained by the syndicate off gross prizemoney (basis points).
  // 1000 = 10%. Applied before pro-rata distribution to shareholders.
  mgmtFeeBps      Int      @default(1000)
  status          String   @default("OPEN") // OPEN | CLOSED | RETIRED

  holdings     ShareHolding[]
  orders       Order[]
  prizeEvents  PrizeEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Aggregated position: how many shares a user holds in one offering.
model ShareHolding {
  id         String   @id @default(cuid())
  userId     String
  offeringId String
  shares     Int      @default(0)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, offeringId])
  @@index([offeringId])
}

// A completed share purchase. Paid directly via Stripe Checkout (e-commerce
// style) - stripeSessionId is unique so a replayed webhook can't double-allocate.
model Order {
  id             String   @id @default(cuid())
  userId         String
  offeringId     String
  shares         Int
  unitPriceCents Int
  totalCents     Int
  status         String   @default("COMPLETED") // PENDING | COMPLETED | REFUNDED
  // Stripe Checkout Session id (or "demo_*" in demo mode). Idempotency key.
  stripeSessionId String? @unique

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([offeringId])
}

// Immutable ledger. balanceAfterCents lets us audit the running balance.
model WalletTransaction {
  id              String   @id @default(cuid())
  userId          String
  // DEPOSIT | SHARE_PURCHASE | PRIZE_PAYOUT | WITHDRAWAL
  type            String
  amountCents     Int // signed: credits positive, debits negative
  balanceAfterCents Int
  description     String   @default("")
  // Optional external references for reconciliation.
  stripeRef       String?
  relatedId       String? // orderId / prizeEventId / withdrawalId

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A prizemoney event for a horse (e.g. "Won R7 Menangle, 12 Aug").
// Recording one triggers a pro-rata distribution across current shareholders.
model PrizeEvent {
  id         String   @id @default(cuid())
  offeringId String
  raceName   String
  raceDate   DateTime @default(now())

  grossCents  Int // total prizemoney received by the syndicate
  mgmtFeeBps  Int // snapshot of fee at time of distribution
  feeCents    Int // grossCents * mgmtFeeBps / 10000 (retained by syndicate)
  // Portion attributable to shares NOT sold to the public (house-retained).
  retainedCents Int      @default(0)
  // Net distributed to public shareholders' wallets.
  distributedCents Int   @default(0)
  status      String   @default("DISTRIBUTED") // DISTRIBUTED

  offering      Offering            @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  distributions PrizeDistribution[]

  createdAt DateTime @default(now())

  @@index([offeringId])
}

// One shareholder's cut of a single prize event.
model PrizeDistribution {
  id           String @id @default(cuid())
  prizeEventId String
  userId       String
  shares       Int // shares held at distribution time
  amountCents  Int // credited to the user's wallet

  prizeEvent PrizeEvent @relation(fields: [prizeEventId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([prizeEventId])
}
