# ---- Database ----
# SQLite for the scaffold. Swap the provider in prisma/schema.prisma to
# postgresql (and change this URL) for production.
DATABASE_URL="file:./dev.db"

# ---- Session ----
# Any long random string. Used to sign the auth cookie (HMAC).
SESSION_SECRET="change-me-to-a-long-random-string"

# ---- Stripe (custom Payment Element gateway) ----
# Leave BLANK to run in DEMO MODE: wallet top-ups are simulated and credited
# instantly (no real charge) so you can exercise the whole flow with no keys.
# Fill these in to use the real Stripe gateway.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# From `stripe listen` / the Stripe dashboard webhook config.
STRIPE_WEBHOOK_SECRET=""

# Base URL of the app (used for redirects / return URLs).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
