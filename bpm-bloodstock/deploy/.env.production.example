# Copy to bpm-bloodstock/.env on the server and fill in real values.
# Keep this file OFF git and readable only by the app user (chmod 600 .env).

# SQLite is fine for a single-server deploy. The file lives at
# bpm-bloodstock/prisma/prod.db — make sure the app user can write to prisma/.
# (Switch to postgresql:// here + in prisma/schema.prisma for multi-server.)
DATABASE_URL="file:./prod.db"

# Sign the auth cookie. Generate once, e.g.:  openssl rand -base64 48
SESSION_SECRET="REPLACE_WITH_openssl_rand_base64_48"

# Public URL of this deployment.
NEXT_PUBLIC_APP_URL="https://admin.jtbassetgroup.com"

# ---- Stripe (leave blank to run in demo mode) ----
# Use LIVE keys only once you're ready to take real money.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Create a webhook endpoint in the Stripe dashboard pointing at
#   https://admin.jtbassetgroup.com/api/stripe/webhook
# and paste its signing secret here.
STRIPE_WEBHOOK_SECRET=""
