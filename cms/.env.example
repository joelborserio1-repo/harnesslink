# Copy to .env. Generate each secret with:  openssl rand -base64 32
HOST=0.0.0.0
PORT=1337
# Public address of the CMS, including any sub-folder it is served under,
# e.g. https://staging.harnesslink.com/cms  (leave empty locally)
PUBLIC_URL=

APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=harnesslink_cms
DATABASE_USERNAME=harnesslink
DATABASE_PASSWORD=harnesslink
DATABASE_SSL=false

# Scheduled publishing runs on Strapi's cron; turn off for one-off scripts.
CRON_ENABLED=true
STRAPI_TELEMETRY_DISABLED=true

# Site search (Meilisearch). Leave MEILI_HOST empty to switch search indexing off.
MEILI_HOST=
MEILI_MASTER_KEY=
