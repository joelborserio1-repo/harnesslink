{
  "kind": "collectionType",
  "collectionName": "ads",
  "info": {
    "singularName": "ad",
    "pluralName": "ads",
    "displayName": "Ad",
    "description": "An advertisement booked into a placement. Rails show three different ads from the same placement."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "zone": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "home-billboard",
        "home-mid",
        "home-bottom",
        "home-rail",
        "article-top",
        "article-bottom",
        "article-rail",
        "archive-rail"
      ]
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imageUrl": {
      "type": "string"
    },
    "imageWidth": {
      "type": "integer",
      "min": 1
    },
    "imageHeight": {
      "type": "integer",
      "min": 1
    },
    "linkUrl": {
      "type": "string",
      "required": true
    },
    "alt": {
      "type": "string"
    },
    "html": {
      "type": "text"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "startsAt": {
      "type": "datetime"
    },
    "endsAt": {
      "type": "datetime"
    },
    "weight": {
      "type": "integer",
      "default": 1,
      "min": 1
    },
    "impressions": {
      "type": "biginteger",
      "default": "0"
    },
    "clicks": {
      "type": "biginteger",
      "default": "0"
    },
    "showAustralia": {
      "type": "boolean",
      "default": false
    },
    "showNewZealand": {
      "type": "boolean",
      "default": false
    },
    "showUSA": {
      "type": "boolean",
      "default": false
    },
    "showCanada": {
      "type": "boolean",
      "default": false
    },
    "showUKIreland": {
      "type": "boolean",
      "default": false
    },
    "showEurope": {
      "type": "boolean",
      "default": false
    },
    "showElsewhere": {
      "type": "boolean",
      "default": false
    }
  }
}
