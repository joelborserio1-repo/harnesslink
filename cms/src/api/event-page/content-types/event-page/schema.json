{
  "kind": "collectionType",
  "collectionName": "event_pages",
  "info": {
    "singularName": "event-page",
    "pluralName": "event-pages",
    "displayName": "Event page",
    "description": "A big-race hub (The Eureka and the next one): countdown, news, TAB odds, social feed, previous winners, slot holders and associates."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "string", "required": true, "unique": true, "regex": "^[a-z0-9][a-z0-9-]*$" },
    "subtitle": { "type": "string" },
    "logo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "heroImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "eventStart": { "type": "datetime" },
    "timezone": { "type": "string", "default": "Australia/Sydney" },
    "countdownFinishedText": { "type": "string" },
    "venue": { "type": "string" },
    "location": { "type": "string" },
    "prizeMoney": { "type": "string" },
    "distance": { "type": "string" },
    "slots": { "type": "string" },
    "eligibility": { "type": "string" },
    "organiserLabel": { "type": "string" },
    "organiserLogo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },

    "showNews": { "type": "boolean", "default": true },
    "newsCategory": { "type": "relation", "relation": "manyToOne", "target": "api::category.category" },
    "newsCount": { "type": "integer", "default": 6, "min": 3, "max": 24 },

    "showOdds": { "type": "boolean", "default": true },
    "oddsTitle": { "type": "string", "default": "Futures" },
    "tabRaceName": { "type": "string" },
    "tabMarketUrl": { "type": "string" },
    "oddsRunnersShown": { "type": "integer", "default": 10, "min": 3, "max": 40 },
    "backupPrices": { "type": "component", "repeatable": true, "component": "event.price" },
    "backupPricesAt": { "type": "string" },

    "showSocial": { "type": "boolean", "default": true },
    "socialTitle": { "type": "string" },
    "curatorFeedId": { "type": "string", "regex": "^[a-f0-9-]{36}$" },
    "xHandle": { "type": "string" },
    "hashtags": { "type": "string" },

    "showResults": { "type": "boolean", "default": true },
    "resultsSponsorLabel": { "type": "string" },
    "results": { "type": "component", "repeatable": true, "component": "event.result" },

    "showAbout": { "type": "boolean", "default": true },
    "aboutHeading": { "type": "string" },
    "aboutSubheading": { "type": "string" },
    "aboutHtml": { "type": "customField", "customField": "plugin::ckeditor5.CKEditor", "options": { "preset": "defaultHtml" } },
    "aboutImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },

    "showSlotHolders": { "type": "boolean", "default": true },
    "slotHoldersHeading": { "type": "string" },
    "slotHoldersNote": { "type": "string" },
    "slotHolders": { "type": "component", "repeatable": true, "component": "event.slot-holder" },

    "showAssociates": { "type": "boolean", "default": true },
    "associatesHeading": { "type": "string", "default": "Official associates" },
    "associates": { "type": "component", "repeatable": true, "component": "event.associate" },

    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
