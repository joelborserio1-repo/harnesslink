{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category",
    "description": "Geographic (USA, Australia\u2026) or editorial (Top 4, Blog)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "geographic",
        "editorial"
      ],
      "default": "geographic",
      "required": true
    },
    "position": {
      "type": "integer",
      "default": 0
    },
    "legacyTermId": {
      "type": "biginteger"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "mappedBy": "categories"
    },
    "primaryArticles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "primaryCategory"
    }
  }
}
